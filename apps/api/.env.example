# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_corp_dev

# Redis
REDIS_URL=redis://localhost:6379

# LLM Providers
NINE_ROUTER_API_KEY=your_9router_api_key
NINE_ROUTER_URL=http://localhost:20128/v1

ANTHROPIC_API_KEY=your_anthropic_api_key

OPENAI_API_KEY=your_openai_api_key

# JWT
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800

# Node Environment
NODE_ENV=development

# Server
PORT=3000

# QC test execution (Task 12): generated projects' Jest suites run in a Docker sandbox
# QC_EXECUTE_TESTS=true
# SANDBOX_TEST_IMAGE=node:18-alpine
# Package mirror the test container may reach (network is disabled when unset)
# SANDBOX_REGISTRY_URL=http://verdaccio:4873
# Run without Docker in a temp copy on the API host (no isolation; local demos only)
# SANDBOX_ALLOW_LOCAL_RUN=false
# QC_TEST_TIMEOUT_MS=180000

# Agent learning (Task 14): refine graded outcomes into a lesson every N outcomes per role
# LEARNING_REFINE_EVERY=3

# Agent collaboration (Task 15): "pair" starts new projects on the collaborative workflow
# (pair_develop: DEV + Architect navigator + BA clarifications, then review_chain: QC → QA)
# WORKFLOW_COLLABORATION=pair

# Integration API (Task 22): requests per minute per API key on /api/v1 (429 + Retry-After above it)
# API_RATE_LIMIT_PER_MINUTE=100
# Webhooks: delivery attempts, first retry delay (doubles each time) and request timeout
# WEBHOOK_MAX_ATTEMPTS=3
# WEBHOOK_RETRY_BASE_MS=1000
# WEBHOOK_TIMEOUT_MS=5000
# Allow webhook URLs on private/loopback networks (local demos only; SSRF protection otherwise)
# WEBHOOK_ALLOW_PRIVATE_NETWORKS=false

# Reports (Task 23): weekly report check interval in minutes (0 disables the scheduler)
# REPORT_SCHEDULER_INTERVAL_MINUTES=60
# TTF font with Vietnamese glyphs for PDF exports (common system fonts are tried when unset)
# PDF_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
