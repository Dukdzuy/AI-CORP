VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000

# PlantUML server used to render *.puml artifacts in Project Detail > Artifacts.
# Diagram sources are sent to this server; point it at a self-hosted one
# (docker run -p 8080:8080 plantuml/plantuml-server) or leave it empty to show source only.
# VITE_PLANTUML_SERVER=https://www.plantuml.com/plantuml
