# Production / demo settings for docker-compose.prod.yml (Phase 7, Task 32).
# Copy to .env.production and replace every CHANGE_ME: the API refuses to start in
# production with a missing or placeholder secret, or a JWT secret under 32 characters.

# Database (used by the postgres service and to build the API's DATABASE_URL)
POSTGRES_USER=aicorp
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ai_corp

# Auth: generate with `openssl rand -hex 32`
JWT_SECRET=CHANGE_ME

# Origin(s) the web app is served from, comma separated
CORS_ORIGIN=http://localhost:8080
WEB_PORT=8080

# LLM gateway (OpenAI-compatible). Offline demo: http://demo-llm:20128/v1 with --profile demo
NINE_ROUTER_URL=http://demo-llm:20128/v1
NINE_ROUTER_API_KEY=CHANGE_ME

# First start only: create the admin account (then set back to false)
SEED_ON_START=true
SEED_ADMIN_EMAIL=admin@aicorp.com
SEED_ADMIN_PASSWORD=CHANGE_ME

# Integration API docs at /api/docs
ENABLE_SWAGGER=false

# QC runs the generated projects' tests. There is no Docker socket in the API container,
# so tests run in a temp copy on the API container itself (it holds no secrets but its env).
QC_EXECUTE_TESTS=true
SANDBOX_ALLOW_LOCAL_RUN=true

# Optional (see apps/api/.env.example for the full list)
# WORKFLOW_COLLABORATION=pair
# REPORT_SCHEDULER_INTERVAL_MINUTES=60
# CODE_QUALITY_MIN_SCORE=70
