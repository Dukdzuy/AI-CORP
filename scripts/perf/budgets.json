    "GET /projects/:id/estimate": { "p50": 300, "p95": 1500, "p99": 3000, "note": "may retrain the estimation model" },
    "GET /projects/:id/code-quality": { "p50": 300, "p95": 1500, "p99": 3000, "note": "parses the generated sources" }
  },
  "maxErrorRate": 0.01
}
