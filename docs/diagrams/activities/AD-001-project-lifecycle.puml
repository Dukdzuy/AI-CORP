@startuml AD-001-project-lifecycle
title Complete Project Lifecycle - Activity Diagram (default OOAD workflow v2.0.0)
'Requirement: Show the full OOAD-driven workflow, its quality gates and loops

|Board Member|
start
:Create Project Request;
:Define Goal & Budget;
:Start Workflow;

|CEO Agent|
:Analyze Project Goal;
:Plan 2-4 Milestones;
note right: taskType = planMilestones

|BA Agent|
:Identify Actors;
:Write Use Cases (UC-001...);
:Render use-cases.md + use case diagram;
:Store ooadMetadata.useCases;

repeat
  |Architect Agent|
  :Derive Domain Model from Use Cases;
  :Choose Layered Architecture & Patterns;
  :Render Class / Sequence Diagrams;
  :Generate Layered Code Skeleton;

  |QA Agent|
  :OOAD Quality Gate;
  note right
    use cases >= 5, entities >= 3,
    patterns >= 3, required docs
    exist in the project workspace
  end note
repeat while (Gate passed?) is (no) not (yes)

|PM Agent|
:Create one Task per Use Case (priority order);

repeat
  |DEV Agent|
  :Implement the Design in the Skeleton;
  :Mark Services with // UC-xxx;
  :Tasks todo → review;

  |QC Agent|
  :Write Acceptance Tests per Use Case;
  :Build Traceability Matrix;
  :Compute Use Case Coverage;

  |QA Agent|
  :Review Code against the Design and QC Report;
  if (qa_approved?) then (yes)
    :Tasks review → done;
  else (no)
    :Tasks review → in_progress;
  endif
repeat while (qa_approved?) is (no) not (yes)

|Marketing Agent|
:Draft Release Announcement;

|Board Member|
:Review Deliverables;
if (Approve Completion?) then (yes)
  |CEO Agent|
  :Write Close-out Report;
  note right: taskType = complete_project
  :Extract Lessons Learned;
  |Board Member|
  :Receive Final Report;
  stop
else (no)
  :Reject (workflow stops);
  stop
endif

@enduml
