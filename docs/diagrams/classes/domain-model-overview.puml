}

package "New Enterprise Features" <<domain>> {
  
  class BARequirementSpec <<aggregate-root>> {
    - id: string
    - projectId: string
    - title: string
    - functionalRequirements: Requirement[]
    - nonFunctionalRequirements: Requirement[]
    - useCases: UseCase[]
    - acceptanceCriteria: Criterion[]
    - createdById: string
    - status: DocumentStatus
    - version: string
    - createdAt: DateTime
    - updatedAt: DateTime
    --
    + addRequirement(req: Requirement): void
    + addUseCase(useCase: UseCase): void
    + updateStatus(status: DocumentStatus): void
    + validate(): boolean
  }
  
  class ArchitectureDocument <<aggregate-root>> {
    - id: string
    - projectId: string
    - title: string
    - architectureStyle: string
    - componentDiagrams: Diagram[]
    - designPatterns: Pattern[]
    - technologyStack: Technology[]
    - qualityAttributes: Attribute[]
    - createdById: string
    - status: DocumentStatus
    - version: string
    - createdAt: DateTime
    - updatedAt: DateTime
    --
    + addComponent(component: Component): void
    + addPattern(pattern: Pattern): void
    + updateStatus(status: DocumentStatus): void
    + validate(): boolean
  }
  
  class TraceabilityReport <<value-object>> {
    - rows: TraceRow[]
    - executed: boolean
    - coveredCount: number
    - failingCount: number
    - totalCount: number
    - coveragePercent: number
    - missingUseCases: string[]
    - failingUseCases: string[]
    - failingTests: string[]
    --
    + markdown(): string
    + {static} qcPassed(report): boolean
  }

  enum UseCaseTestStatus <<value-object>> {
    Passing
    Failing
    Missing
    Covered (not executed)
  }

  class TestExecutionSummary <<value-object>> {
    - executed: boolean
    - passed: number
    - failed: number
    - byUseCase: Map<UseCaseId, UseCaseExecution>
    - reason?: string
  }
  
  enum DocumentStatus <<value-object>> {
    draft
    review
    approved
    obsolete
  }
  
}

' ========================================
' RELATIONSHIPS
' ========================================

' Agent relationships
IAgent <|.. Agent : implements
IAgent <|.. BaseAgent : implements
BaseAgent <|-- CeoAgent
BaseAgent <|-- BaAgent
BaseAgent <|-- ArchitectAgent
BaseAgent <|-- PmAgent
BaseAgent <|-- DevAgent
BaseAgent <|-- QcAgent
BaseAgent <|-- QaAgent
BaseAgent <|-- MarketingAgent
BaseAgent --> RoleProfile : identity & defaults
RoleProfile --> AgentRole
RoleProfile --> ModelRouteConfig : default model

Agent *-- AgentStateMachine : contains
Agent *-- AgentEventEmitter : contains
Agent --> AgentRole : has
Agent --> AgentState : has
Agent --> ModelRouteConfig : configured with

Agent "1" *-- "0..*" AgentMemory : contains
Agent "1" *-- "0..*" AgentMessage : sends

AgentEventEmitter o-- "0..*" IAgentObserver : notifies

IThinkingStrategy <|.. ThinkingStrategies
IActionStrategy <|.. ActionStrategies

BaseAgent o-- IThinkingStrategy : thinkingStrategy
BaseAgent o-- IActionStrategy : actionStrategy

' Project relationships
Project "1" *-- "0..*" Milestone : contains
Project "1" *-- "0..*" Task : contains
Milestone "1" o-- "0..*" Task : groups
Project --> ProjectStatus : has
Task --> TaskStatus : has
Task --> Priority : has
Task --> AgentRole : assigned to
Project --> Money : has budget
Task --> Money : has cost

User "1" --> "0..*" Project : creates

' Workflow relationships
WorkflowRun "1" *-- "1..*" WorkflowStep : contains
WorkflowRun "1" *-- "0..*" Approval : requests
WorkflowRun --> WorkflowStatus : has
WorkflowStep --> StepStatus : has
Approval --> ApprovalStatus : has
WorkflowRun --> Project : executes for
WorkflowStep --> Task : executes
Approval --> User : requests from

' Tool relationships
ITool <|.. WriteFileTool : implements
ITool <|.. ReadFileTool : implements
ITool <|.. RunTestsTool : implements
IToolExecutor <|.. SandboxExecutor : implements
ToolRegistry o-- "0..*" ITool : registers
ActionStrategies ..> SandboxExecutor : runs commands (Task 12)

' API Usage relationships
ApiUsageLog --> Project : tracks for
ApiUsageLog --> AgentRole : tracks
ApiUsageLog --> Money : records cost

' New enterprise feature relationships
BARequirementSpec --> Project : documents
ArchitectureDocument --> Project : designs
TraceabilityReport --> Project : verifies
BaAgent ..> BARequirementSpec : creates
ArchitectAgent ..> ArchitectureDocument : creates
QcAgent ..> TraceabilityReport : builds
QcAgent ..> TestExecutionSummary : runs tests (ProjectTestRunner)
TraceabilityReport ..> TestExecutionSummary : statuses from
TraceabilityReport ..> UseCaseTestStatus

note top of Agent
  **Aggregate Root**: Agent
  
  **Invariants**:
  - Role is unique across all agents
  - Can only be in one state at a time
  - State transitions must be valid
  
  **Patterns**: Strategy, State, Observer
end note

note top of Project
  **Aggregate Root**: Project
  
  **Invariants**:
  - Budget must be positive when set
  - Cost accrued <= budget
  - Cannot delete with active workflows
  
  **Consistency Boundary**: Project + Milestones + Tasks
end note

note top of WorkflowRun
  **Aggregate Root**: WorkflowRun
  
  **Invariants**:
  - Status transitions must be valid
  - Cannot modify completed/failed workflows
  - Approval must resolve before proceeding
  
  **Consistency Boundary**: WorkflowRun + Steps + Approvals
end note

@enduml
