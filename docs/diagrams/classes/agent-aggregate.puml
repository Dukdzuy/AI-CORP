' ========================================
' STRATEGY PATTERN
' ========================================

package "Strategy Pattern" <<pattern>> {
  
  interface IThinkingStrategy <<interface>> {
    + think(context: AgentContext): Promise<AgentThought>
  }
  
  interface IActionStrategy<TOutput> <<interface>> {
    + act(context: AgentContext, thought: AgentThought): Promise<AgentActionResult<TOutput>>
  }

  class "CeoThinkingStrategy\nBAThinkingStrategy\nArchitectThinkingStrategy\nPmThinkingStrategy\nDevThinkingStrategy\nQcThinkingStrategy\nQaThinkingStrategy\nMarketingThinkingStrategy" as ThinkingStrategies <<ConcreteStrategy>> {
    + think(context): Promise<AgentThought>
    --
    recalls memories from profile.primaryNamespace
  }

  class "CeoActionStrategy → CeoOutput\nBAActionStrategy → BaOutput\nArchitectActionStrategy → ArchitectOutput\nPmActionStrategy → PmOutput\nDevActionStrategy → DevOutput\nQcActionStrategy → QcOutput\nQaActionStrategy → QaOutput\nMarketingActionStrategy → MarketingOutput" as ActionStrategies <<ConcreteStrategy>> {
    + act(context, thought): Promise<AgentActionResult<XxxOutput>>
    --
    LLM via AgentLLMService.providerFor(profile)
  }

  class AgentLLMService <<facade>> {
    + providerFor(profile: RoleProfile, projectId?): {provider, model, systemPrompt}
  }
}

package "Registry" <<pattern>> {
  class "AGENTS token" as AgentsToken <<multi-provider>> {
    useFactory: (...agents) => agents
    inject: AGENT_CLASSES
  }

  class AgentOrchestratorService {
    - agentRegistry: Map<string, IAgent>
    --
    + constructor(@Inject(AGENTS) agents: IAgent[], messages)
    + invokeAgent(role, context): Promise<AgentResult>
    + getAvailableRoles(): string[]
    + hasAgent(role): boolean
  }
}

